# Copy to .env.local for local development. Never commit the populated file.
APP_URL=http://127.0.0.1:3210
# Local loopback access works without OWNER_PASSWORD. Remote access requires both:
OWNER_PASSWORD=
SESSION_SECRET=
# Generate locally with `openssl rand -hex 32`; protect and back up the value.
TOKEN_ENCRYPTION_KEY=
# Default SQLite at data/storyman.sqlite; production PostgreSQL URL is optional.
DATABASE_URL=
# Required only by compose.yaml. Use a random local value and keep it secret.
POSTGRES_PASSWORD=
STORYMAN_DATA_DIR=./data
DATA_DIR=./data
STORAGE_DIR=./data/artifacts

# Preferred grounded-story writer: OpenCode CLI with a listed Zen free model.
# Free access is subject to provider quota/availability; AI_* below is the fallback.
WRITING_PROVIDER=opencode-cli
OPENCODE_MODEL=opencode/glm-5.3-flash-free
OPENCODE_PATH=opencode
# OpenAI-compatible or native Ollama fallback. The base includes /v1 when required.
# Local compatible providers may omit AI_API_KEY.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional native local Ollama structured output / bounded timeout.
AI_PROVIDER=
AI_TIMEOUT_MS=300000
# Gemini TTS is preferred when GEMINI_API_KEY is set; TTS_PROVIDER overrides auto-detection.
# Use `gemini` for the Interactions API or `openai-compatible` for the fallback below.
TTS_PROVIDER=
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Riko
GEMINI_TTS_STYLE=Rich, velvety, unhurried audiobook narration
# Optional proxy/regional endpoint. Default: https://generativelanguage.googleapis.com/v1beta
GEMINI_TTS_BASE_URL=
# OpenAI-compatible TTS fallback, used only when narration is not uploaded and Gemini is not selected.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# Optional provider-specific additions; unset for services that reject language.
TTS_LANGUAGE=
TTS_CHUNK_CHARS=1800

# Documentary template brand chrome. Handle appears as the bottom-left watermark.
BRAND_HANDLE=@storyman
BRAND_MARK=S
# Optional renderer override; otherwise 12fps for shorts, 10fps up to 90s, 8fps for long masters.
RENDER_MOTION_FPS=

# Optional real STT word timestamps. Install requirements-alignment.txt separately.
# JSON argv array; no shell interpretation. Use an absolute venv Python for services.
ALIGNMENT_COMMAND_JSON=["python3","scripts/align.py","--audio","{audio}","--output","{output}"]
WHISPER_MODEL=small
WHISPER_LANGUAGE=tl
PYTHON_PATH=python3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Set developer-app credentials server-side, then authorize through Connections.
# Register APP_URL/api/connections/<provider>/callback with the corresponding app.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_PAGE_ID=
META_GRAPH_VERSION=v27.0
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Keep false until the owner has reviewed variants and authorized live publication.
ENABLE_LIVE_PUBLISHING=false
