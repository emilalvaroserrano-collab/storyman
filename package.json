{
  "name": "storyman",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "node --env-file-if-exists=.env.local --import tsx scripts/doctor.ts",
    "media:verify": "tsx scripts/verify-media.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
